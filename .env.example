# GlobalFlood AI Environment Variables

# Service Environment
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Optional Copernicus Data Space Ecosystem (CDSE) Credentials
# Free registration at https://dataspace.copernicus.eu
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=

# Optional Google Earth Engine Service Account
EARTH_ENGINE_SERVICE_ACCOUNT=
EARTH_ENGINE_PRIVATE_KEY_PATH=

# Cache & Timeouts
HTTP_TIMEOUT_SECONDS=15.0
CACHE_EXPIRY_SECONDS=1800
